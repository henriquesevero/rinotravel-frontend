# URL da API. No emulador Android use http://10.0.2.2:8080 (o localhost do emulador é ele mesmo).
# Em produção (Vercel) é embutida no build: use a URL pública da API no Railway, com https.
EXPO_PUBLIC_API_URL=http://localhost:8080

# Chave de NAVEGADOR (não a do servidor) para o mapa incorporado na tela de deslocamentos.
# No Google Cloud: ative a "Maps Embed API", crie uma chave restrita a essa API e a referenciadores HTTP
# (http://localhost:3000/*, http://localhost:8081/* e o endereço da Vercel). Vazio esconde o mapa e deixa
# só os botões "Abrir no Google Maps" e "Compartilhar", que não precisam de chave.
EXPO_PUBLIC_GOOGLE_MAPS_EMBED_KEY=
