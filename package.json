    "@types/jest": "^30.0.0",
    "@types/react": "~19.2.2",
    "eslint": "^9.39.5",
    "jest": "^29.7.0",
    "jest-expo": "~57.0.5",
    "msw": "^2.15.0",
    "prettier": "^3.9.8",
    "react-test-renderer": "^19.2.3",
    "serve": "^14.2.6",
    "typescript": "~6.0.3"
  },
  "scripts": {
    "start": "expo start",
    "android": "expo start --android",
    "ios": "expo start --ios",
    "web": "expo start --web",
    "lint": "expo lint",
    "typecheck": "tsc --noEmit",
    "test": "jest",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "api:types": "npx --yes openapi-typescript@7.13.0 ../rinotravel-api/docs/openapi.yaml -o src/core/api/schema.d.ts",
    "build:web": "expo export --platform web",
    "e2e": "npm run build:web:e2e && playwright test",
    "check": "npm run format:check && npm run lint && npm run typecheck && npm test",
    "preview": "node scripts/preview.mjs dist 3000",
    "build:web:e2e": "EXPO_PUBLIC_API_URL=http://localhost:18080 EXPO_PUBLIC_GOOGLE_MAPS_BROWSER_KEY=e2e-fake-browser-key expo export --clear --platform web --output-dir dist-e2e"
  },
  "private": true
}
